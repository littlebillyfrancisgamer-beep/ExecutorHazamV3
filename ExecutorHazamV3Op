-- Helper function to quickly add rounded corners
local function AddCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or UDim.new(0, 6)
	corner.Parent = parent
	return corner
end

-- Helper function to enable Mouse Wheel X-Axis Horizontal Scrolling
local function EnableHorizontalMouseScroll(scrollingFrame)
	scrollingFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			scrollingFrame.CanvasPosition = Vector2.new(
				math.clamp(scrollingFrame.CanvasPosition.X - (input.Position.Z * 40), 0, math.max(0, scrollingFrame.AbsoluteCanvasSize.X - scrollingFrame.AbsoluteSize.X)),
				scrollingFrame.CanvasPosition.Y
			)
		end
	end)
end

