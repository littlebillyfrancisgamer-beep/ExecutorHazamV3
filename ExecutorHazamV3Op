-- Generate Heavy Snowflakes (120 snowflakes)
local snowflakes = {}
local rng = Random.new()

for i = 1, 120 do
	local flake = Instance.new("Frame")
	flake.Name = "Snowflake"
	flake.Parent = SnowContainer
	flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	flake.BorderSizePixel = 0
	
	local size = rng:NextNumber(2, 6)
	flake.Size = UDim2.new(0, size, 0, size)
	AddCorner(flake, UDim.new(1, 0))
	
	local posX = rng:NextNumber(0, 1)
	local posY = rng:NextNumber(-0.2, 1)
	flake.Position = UDim2.new(posX, 0, posY, 0)
	
	table.insert(snowflakes, {
		Object = flake,
		Speed = rng:NextNumber(0.12, 0.35),
		Drift = rng:NextNumber(-0.04, 0.04)
	})
end

-- Snow animation loop
local snowConnection
snowConnection = RunService.RenderStepped:Connect(function(dt)
	if not Backdrop.Visible then return end
	for _, flakeData in ipairs(snowflakes) do
		local flake = flakeData.Object
		if flake and flake.Parent then
			local pos = flake.Position
			local newY = pos.Y.Scale + (flakeData.Speed * dt)
			local newX = pos.X.Scale + (flakeData.Drift * dt * 0.2)
			
			if newY > 1.05 then
				newY = -0.05
				newX = rng:NextNumber(0, 1)
			end
			
			if newX < 0 then newX = 1 elseif newX > 1 then newX = 0 end
			flake.Position = UDim2.new(newX, 0, newY, 0)
		end
	end
end)

