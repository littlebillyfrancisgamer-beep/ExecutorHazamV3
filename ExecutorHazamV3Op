local SwitchEditorTab = function(tabId)
	if activeTabId and editorTabs[activeTabId] then
		editorTabs[activeTabId].Content = ScriptBox.Text
		editorTabs[activeTabId].Button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		editorTabs[activeTabId].Button.TextColor3 = Color3.fromRGB(170, 170, 170)
	end
	
	activeTabId = tabId
	local tabData = editorTabs[tabId]
	if tabData then
		ScriptBox.Text = tabData.Content
		tabData.Button.BackgroundColor3 = Color3.fromRGB(0, 130, 200)
		tabData.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end

local function CreateNewEditorTab(customTitle, initialContent)
	local tabId = tostring(math.random(10000, 99999))
	local count = 0
	for _ in pairs(editorTabs) do count = count + 1 end
	local title = customTitle or ("Script Tab " .. (count + 1))

	local tabBtn = Instance.new("TextButton")
	tabBtn.Name = "Tab_" .. tabId
	tabBtn.Parent = EditorTabBar
	tabBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	tabBtn.BorderSizePixel = 0
	tabBtn.Size = UDim2.new(0, 110, 1, 0)
	tabBtn.Font = Enum.Font.GothamBold
	tabBtn.Text = title
	tabBtn.TextColor3 = Color3.fromRGB(170, 170, 170)
	tabBtn.TextSize = 10
	tabBtn.ZIndex = 2
	AddCorner(tabBtn, UDim.new(0, 6))

	local closeTabBtn = Instance.new("TextButton")
	closeTabBtn.Name = "Close"
	closeTabBtn.Parent = tabBtn
	closeTabBtn.BackgroundTransparency = 1
	closeTabBtn.Position = UDim2.new(1, -16, 0.5, -8)
	closeTabBtn.Size = UDim2.new(0, 16, 0, 16)
	closeTabBtn.Font = Enum.Font.GothamBold
	closeTabBtn.Text = "×"
	closeTabBtn.TextColor3 = Color3.fromRGB(200, 100, 100)
	closeTabBtn.TextSize = 12
	closeTabBtn.ZIndex = 2

	editorTabs[tabId] = {
		Button = tabBtn,
		Content = initialContent or ""
	}

	tabBtn.MouseButton1Click:Connect(function()
		SwitchEditorTab(tabId)
	end)

	closeTabBtn.MouseButton1Click:Connect(function()
		local totalTabs = 0
		for _ in pairs(editorTabs) do totalTabs = totalTabs + 1 end
		if totalTabs <= 1 then return end
		
		if activeTabId == tabId then
			for id, _ in pairs(editorTabs) do
				if id ~= tabId then
					SwitchEditorTab(id)
					break
				end
			end
		end
		
		editorTabs[tabId] = nil
		tabBtn:Destroy()
	end)

	SwitchEditorTab(tabId)
end

