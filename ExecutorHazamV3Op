local SwitchTab = function(activeTab)
	HubsPage.Visible = (activeTab == "Hubs")
	PlayersPage.Visible = (activeTab == "Players")
	EditorPage.Visible = (activeTab == "Editor")
	FinderPage.Visible = (activeTab == "Finder")
	CombinedPage.Visible = (activeTab == "Combined")
	AddrsPage.Visible = (activeTab == "Addrs")
	DexPage.Visible = (activeTab == "Dex")
	SettingsPage.Visible = (activeTab == "Settings")

	local function updateTabStyle(btn, isActive)
		btn.BackgroundColor3 = isActive and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(30, 30, 30)
		btn.TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(170, 170, 170)
	end

	updateTabStyle(HubsTabBtn, activeTab == "Hubs")
	updateTabStyle(PlayersTabBtn, activeTab == "Players")
	updateTabStyle(EditorTabBtn, activeTab == "Editor")
	updateTabStyle(FinderTabBtn, activeTab == "Finder")
	updateTabStyle(CombinedTabBtn, activeTab == "Combined")
	updateTabStyle(AddrsTabBtn, activeTab == "Addrs")
	updateTabStyle(DexTabBtn, activeTab == "Dex")
	updateTabStyle(SettingsTabBtn, activeTab == "Settings")
end

