ExecuteCodeString = function(code, scriptName)
	if code and code ~= "" then
		local func, parseErr = loadstring(code)
		if func then
			local success, runErr = pcall(func)
			if success then
				ShowNotification("Successfully Executed\n" .. scriptName)
			else
				warn("Runtime Error: " .. tostring(runErr))
			end
		else
			warn("Syntax Error: " .. tostring(parseErr))
		end
	end
end

