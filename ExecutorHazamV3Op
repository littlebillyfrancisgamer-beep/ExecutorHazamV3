local function FetchScriptBlox(query)
	for _, child in ipairs(FinderScroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	
	if query == "" then return end
	ShowNotification("Searching ScriptBlox...")

	task.spawn(function()
		local success, result = pcall(function()
			local url = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query) .. "&mode=free"
			local response = game:HttpGet(url)
			return HttpService:JSONDecode(response)
		end)

		if success and result and result.result and result.result.scripts then
			local scripts = result.result.scripts
			if #scripts == 0 then
				ShowNotification("No scripts found on ScriptBlox.")
				return
			end

			for _, sData in ipairs(scripts) do
				pcall(function()
					local sCard = Instance.new("Frame")
					sCard.Parent = FinderScroll
					sCard.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
					sCard.BorderSizePixel = 0
					sCard.Size = UDim2.new(1, 0, 0, 85)
					sCard.ZIndex = 2
					AddCorner(sCard, UDim.new(0, 6))

					local titleLbl = Instance.new("TextLabel")
					titleLbl.Parent = sCard
					titleLbl.BackgroundTransparency = 1
					titleLbl.Position = UDim2.new(0.03, 0, 0.08, 0)
					titleLbl.Size = UDim2.new(0.55, 0, 0, 22)
					titleLbl.Font = Enum.Font.GothamBold
					titleLbl.Text = sData.title or "Untitled Script"
					titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
					titleLbl.TextSize = 11
					titleLbl.TextXAlignment = Enum.TextXAlignment.Left
					titleLbl.ZIndex = 2

					local gameName = "Universal"
					if sData.game and sData.game.name then
						gameName = sData.game.name
					end

					local hasKey = (sData.isKey == true) or (sData.key == true) or (sData.keyURL and sData.keyURL ~= "")
					local keyStatusText = hasKey and "🔑 Key Required" or "🔓 Keyless"
					local keyColor = hasKey and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(80, 255, 120)
					
					local viewsCount = sData.views or 0
					local viewsText = "👁️ " .. tostring(viewsCount) .. " views"

					local subLbl = Instance.new("TextLabel")
					subLbl.Parent = sCard
					subLbl.BackgroundTransparency = 1
					subLbl.Position = UDim2.new(0.03, 0, 0.38, 0)
					subLbl.Size = UDim2.new(0.55, 0, 0, 20)
					subLbl.Font = Enum.Font.Gotham
					subLbl.Text = "Game: " .. gameName
					subLbl.TextColor3 = Color3.fromRGB(170, 170, 170)
					subLbl.TextSize = 9
					subLbl.TextXAlignment = Enum.TextXAlignment.Left
					subLbl.ZIndex = 2

					local keyLbl = Instance.new("TextLabel")
					keyLbl.Parent = sCard
					keyLbl.BackgroundTransparency = 1
					keyLbl.Position = UDim2.new(0.03, 0, 0.65, 0)
					keyLbl.Size = UDim2.new(0.30, 0, 0, 20)
					keyLbl.Font = Enum.Font.GothamBold
					keyLbl.Text = keyStatusText
					keyLbl.TextColor3 = keyColor
					keyLbl.TextSize = 9
					keyLbl.TextXAlignment = Enum.TextXAlignment.Left
					keyLbl.ZIndex = 2

					local viewsLbl = Instance.new("TextLabel")
					viewsLbl.Parent = sCard
					viewsLbl.BackgroundTransparency = 1
					viewsLbl.Position = UDim2.new(0.33, 0, 0.65, 0)
					viewsLbl.Size = UDim2.new(0.25, 0, 0, 20)
					viewsLbl.Font = Enum.Font.GothamBold
					viewsLbl.Text = viewsText
					viewsLbl.TextColor3 = Color3.fromRGB(170, 170, 170)
					viewsLbl.TextSize = 9
					viewsLbl.TextXAlignment = Enum.TextXAlignment.Left
					viewsLbl.ZIndex = 2

					local loadBtn = Instance.new("TextButton")
					loadBtn.Parent = sCard
					loadBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
					loadBtn.BorderSizePixel = 0
					loadBtn.Position = UDim2.new(0.59, 0, 0.08, 0)
					loadBtn.Size = UDim2.new(0.38, 0, 0, 21)
					loadBtn.Font = Enum.Font.GothamBold
					loadBtn.Text = "Load to Editor"
					loadBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					loadBtn.TextSize = 9
					loadBtn.ZIndex = 2
					AddCorner(loadBtn, UDim.new(0, 4))

					loadBtn.MouseButton1Click:Connect(function()
						if sData.script then
							CreateNewEditorTab(sData.title or "Script", sData.script)
							SwitchTab("Editor")
							ShowNotification("Loaded script into Editor!")
						else
							ShowNotification("Error: Script code empty.")
						end
					end)

					local execBtn = Instance.new("TextButton")
					execBtn.Parent = sCard
					execBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 200)
					execBtn.BorderSizePixel = 0
					execBtn.Position = UDim2.new(0.59, 0, 0.38, 0)
					execBtn.Size = UDim2.new(0.38, 0, 0, 21)
					execBtn.Font = Enum.Font.GothamBold
					execBtn.Text = "Execute Script"
					execBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					execBtn.TextSize = 9
					execBtn.ZIndex = 2
					AddCorner(execBtn, UDim.new(0, 4))

					execBtn.MouseButton1Click:Connect(function()
						if sData.script then
							ExecuteCodeString(sData.script, sData.title or "Script")
						else
							ShowNotification("Error: Script code empty.")
						end
					end)

					local copyBtn = Instance.new("TextButton")
					copyBtn.Parent = sCard
					copyBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
					copyBtn.BorderSizePixel = 0
					copyBtn.Position = UDim2.new(0.59, 0, 0.68, 0)
					copyBtn.Size = UDim2.new(0.38, 0, 0, 21)
					copyBtn.Font = Enum.Font.GothamBold
					copyBtn.Text = "Copy Loadstring"
					copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					copyBtn.TextSize = 9
					copyBtn.ZIndex = 2
					AddCorner(copyBtn, UDim.new(0, 4))

					copyBtn.MouseButton1Click:Connect(function()
						pcall(function()
							if sData.script and setclipboard then
								setclipboard(sData.script)
								ShowNotification("Copied script to clipboard!")
							else
								ShowNotification("Clipboard function not supported.")
							end
						end)
					end)
				end)
			end
			ShowNotification("Found " .. tostring(#scripts) .. " scripts!")
		else
			ShowNotification("Failed to fetch from ScriptBlox API.")
		end
	end)
end

