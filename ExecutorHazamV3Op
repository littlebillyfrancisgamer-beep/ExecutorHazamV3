	Players.LocalPlayer:Kick("Left the game via Custom Executor.")
end)

-- Open/Close UI
local isOpen = true
local function ToggleGUI()
	isOpen = not isOpen
	if isOpen then
		MainFrame.Visible = true
		Backdrop.Visible = true
		Backdrop.Active = false
		MainFrame.Size = UDim2.new(0, 420, 0, 330)
		MainFrame.BackgroundTransparency = 1
		Backdrop.BackgroundTransparency = 1
		
		TweenService:Create(Backdrop, TweenInfo.new(0.3), {BackgroundTransparency = 0.4}):Play()
		local tweenOpen = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 520, 0, 390),
			BackgroundTransparency = 0
		})
		tweenOpen:Play()
	else
		Backdrop.Active = false
		TweenService:Create(Backdrop, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
		local tweenClose = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 420, 0, 330),
			BackgroundTransparency = 1
		})
		tweenClose:Play()
		tweenClose.Completed:Connect(function()
			if not isOpen then 
				MainFrame.Visible = false 
				Backdrop.Visible = false
			end
		end)
	end
end

CloseBtn.MouseButton1Click:Connect(ToggleGUI)
ToggleButton.MouseButton1Click:Connect(ToggleGUI)

BuildPlayerList()
